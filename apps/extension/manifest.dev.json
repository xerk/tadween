{
  "manifest_version": 3,
  "name": "Tadween (dev)",
  "version": "1.0.0",
  "key": "",
  "description": "Connect your Skool account to Tadween, so you can schedule and publish posts to your Skool communities from Tadween.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "cookies",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "*://*.skool.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://localhost/*"
    ]
  }
}
