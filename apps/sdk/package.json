  "description": "Node.js SDK for the Tadween public API: schedule social media posts, upload media and list channels",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "release": "tsup && pnpm publish --access public --no-git-checks"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
