  ],
  "license": "AGPL-3.0",
  "homepage": "https://tadween.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xerk/tadween.git",
    "directory": "apps/sdk"
  },
  "bugs": {
    "url": "https://github.com/xerk/tadween/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
