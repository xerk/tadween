{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tadween": {
      "type": "streamable-http",
      "url": "https://studio.tadween.app/mcp-oauth-dynamic",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mcp:read",
              "mcp:write"
            ]
          }
        }
      }
    }
  }
}